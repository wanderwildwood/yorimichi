<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Detour</string>

    <!-- ============================================================ -->
    <!-- Walk screen: the one main screen -->

    <!-- Top bar title: the app's name -->
    <string name="walk_title">Detour</string>
    <!-- Cog button in the top bar, read aloud by a screen reader -->
    <string name="walk_cd_settings">Settings</string>

    <!-- Before the location permission is granted -->
    <string name="walk_asking_why">Detour needs to know where you are, to scatter its points around you.</string>
    <string name="walk_asking_privacy">It stays on the phone and is not sent anywhere. The app has no way to reach the network.</string>
    <!-- Button that asks for the location permission (verb) -->
    <string name="walk_allow">Allow</string>
    <!-- When the location permission has been refused and Android will no longer ask -->
    <string name="walk_refused_why">Location is not allowed for Detour, so it cannot tell where you are.</string>
    <string name="walk_refused_how">Allow it in Detour\'s app settings, under Permissions, then Location.</string>
    <!-- Button that opens Detour's page in the system settings -->
    <string name="walk_open_app_settings">Open app settings</string>
    <!-- Button that opens the system location settings, shown while location is off -->
    <string name="walk_turn_on_location">Turn on location</string>

    <!-- Before a walk. %1$s is the radius, e.g. "2 km" or "1 mile"; %2$s is one of the look_ phrases below -->
    <string name="walk_within">Within %1$s, %2$s.</string>
    <!-- The big button that picks a point to walk to (verb) -->
    <string name="walk_go">Go</string>

    <!-- After a walk is picked. %1$s is a compass bearing, e.g. "NNE 32°"; shown when the phone has no compass -->
    <string name="walk_bearing_no_compass">%1$s — no compass on this phone</string>
    <!-- Button that hands the point to a map app -->
    <string name="walk_open_in_maps">Open in maps</string>
    <!-- Button that picks a new point instead of this one -->
    <string name="walk_somewhere_else">Somewhere else</string>

    <!-- Which end of the random scatter to walk to. Lower case: they are used mid-sentence after walk_within, and capitalised by the app for the settings row -->
    <string name="look_gather">where the points gather</string>
    <string name="look_thin">where they thin out</string>

    <!-- ============================================================ -->
    <!-- Walk screen: distances, the compass, and what is known about the fix.
         Every %1$s below that stands for a number is given already written out, in
         Western digits -->

    <!-- Distances. %1$s is a whole number for feet and metres, and has one decimal
         place for miles and kilometres, e.g. "0.6 mi" or "1.0 km" -->
    <string name="walk_arrived">You are here</string>
    <!-- %1$s is a distance, e.g. "80 ft" -->
    <string name="walk_arrived_within">Within %1$s of the point</string>
    <!-- %1$s is an age, e.g. "2 min" -->
    <string name="walk_lost_old">Position lost %1$s ago, so the distance is not following you</string>
    <string name="walk_lost_none">No position, so the distance is not following you</string>
    <string name="walk_lost_off">Location is off, so the distance is not following you</string>
    <string name="distance_feet">%1$s ft</string>
    <string name="distance_miles">%1$s mi</string>
    <string name="distance_metres">%1$s m</string>
    <string name="distance_kilometres">%1$s km</string>

    <!-- The walks offered in settings, and shown in walk_within. Metric ones use
         distance_metres and distance_kilometres above. Miles are spelled out here,
         not abbreviated -->
    <string name="radius_quarter_mile">¼ mile</string>
    <string name="radius_half_mile">½ mile</string>
    <!-- %1$s is 1, 3 or 5 -->
    <plurals name="radius_miles">
        <item quantity="one">%1$s mile</item>
        <item quantity="other">%1$s miles</item>
    </plurals>

    <!-- The sixteen compass points, abbreviated, beside the arrow: N is north, NNE is
         north-northeast, and so on round. Keep them as short as they are here -->
    <string name="compass_n">N</string>
    <string name="compass_nne">NNE</string>
    <string name="compass_ne">NE</string>
    <string name="compass_ene">ENE</string>
    <string name="compass_e">E</string>
    <string name="compass_ese">ESE</string>
    <string name="compass_se">SE</string>
    <string name="compass_sse">SSE</string>
    <string name="compass_s">S</string>
    <string name="compass_ssw">SSW</string>
    <string name="compass_sw">SW</string>
    <string name="compass_wsw">WSW</string>
    <string name="compass_w">W</string>
    <string name="compass_wnw">WNW</string>
    <string name="compass_nw">NW</string>
    <string name="compass_nnw">NNW</string>
    <!-- The bearing beside the arrow, e.g. "NNE 32°". %1$s is a compass point from
         above, %2$s the bearing in whole degrees, 0 to 359 -->
    <string name="bearing">%1$s %2$s°</string>

    <!-- Under the distance: how the random points fell where the walk was sent, compared
         with an even spread of them. %1$s is how many times, with one decimal place,
         always 2.0 or more -->
    <string name="reading_thicker">The points fell %1$s times thicker here than an even scatter.</string>
    <string name="reading_little_thicker">A little thicker here than an even scatter.</string>
    <string name="reading_ordinary">No thicker here than chance usually gives.</string>
    <string name="reading_little_thinner">A little thinner here than an even scatter.</string>
    <string name="reading_thinner">The points fell %1$s times thinner here than an even scatter.</string>

    <!-- Before a walk: what the phone knows about its own position (a "fix", from GPS) -->
    <!-- No position at all yet; the GPS is listening -->
    <string name="fix_searching">Looking for a GPS fix</string>
    <string name="hint_searching">GPS needs open sky. Indoors it can take minutes, or never come.</string>
    <!-- No position at all after two minutes of listening -->
    <string name="fix_not_found">No GPS fix yet</string>
    <string name="hint_not_found">Try outside, away from walls and tall buildings, with this screen open. Detour carries on as soon as a fix comes.</string>
    <!-- No position at all, and location is switched off for the whole phone -->
    <string name="fix_off">Location is off on this phone</string>
    <string name="hint_off">Detour needs it on to find where you are.</string>
    <!-- An old position is being used. %1$s is an age from the age_ strings below, e.g. "2 hr" -->
    <string name="fix_stale">From where the phone was %1$s ago</string>
    <!-- Under fix_stale, while the GPS is still listening -->
    <string name="hint_stale_looking">Still looking for a fresh fix, and will use it as soon as one comes.</string>
    <!-- Under fix_stale, while location is switched off -->
    <string name="hint_stale_off">Location is off, so it cannot look for a fresh one.</string>
    <string name="fix_unknown_accuracy">Fix of unknown accuracy</string>
    <!-- %1$s is a distance from the distance_ strings above, e.g. "10 m" -->
    <string name="fix_good_to">Fix within %1$s</string>
    <!-- How old the fix is. "min" is minutes and "hr" is hours, abbreviated -->
    <string name="age_minutes">%1$s min</string>
    <string name="age_hours">%1$s hr</string>
    <plurals name="age_days">
        <item quantity="one">%1$s day</item>
        <item quantity="other">%1$s days</item>
    </plurals>

    <!-- ============================================================ -->
    <!-- Settings screen -->

    <string name="settings_title">Settings</string>
    <!-- Top bar buttons, read aloud by a screen reader -->
    <string name="settings_cd_close">Close</string>
    <string name="settings_cd_about">About</string>
    <!-- Setting row: the walk radius -->
    <string name="settings_radius">How far it may send you</string>
    <!-- Setting row: which end of the scatter to walk to -->
    <string name="settings_look_for">Look for</string>
    <!-- Setting row: the units distances are shown in, and its two values -->
    <string name="settings_distances">Distances</string>
    <string name="settings_units_imperial">Miles and feet</string>
    <string name="settings_units_metric">Kilometres and metres</string>

    <!-- ============================================================ -->
    <!-- About: three pages. Keep the names of the app, projects and licences as they are -->

    <!-- Heading. %1$s is the version number, e.g. 0.1.0 -->
    <string name="about_title">Detour %1$s</string>
    <!-- Page 1 -->
    <string name="about_what">Detour gives you a place within walking distance, picked from the phone\'s own random numbers, and points the way.</string>
    <string name="about_randomness">The numbers come from the phone\'s own generator. They are not quantum, and nothing here has been shown to know anything.</string>
    <string name="about_safety_heading">Before you go</string>
    <!-- Also shown with the destination, and once on first opening -->
    <string name="safety_notice">Random places can be private property or unsafe. Respect signs and owners, and do not go anywhere you would not go without the app.</string>
    <!-- Page 2 -->
    <string name="about_privacy_heading">Privacy</string>
    <string name="about_privacy">Everything stays on this phone. The app has no internet access, so nothing is sent anywhere, and nothing is collected about you.\n\nIt uses the phone\'s location while it is open, to place a walk around you. The last position is kept on the phone, one only, so the app can start indoors. Open in maps hands the destination to the map app you pick; the app has no map of its own. The links at the foot of About open your browser.\n\nThere are no ads, no analytics and no tracking. Backups and exports go only where you choose to save them.</string>
    <string name="about_terms_heading">Terms</string>
    <string name="about_terms">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk.\n\nRandom places can be private property or unsafe. Respect signs and owners, and do not go anywhere you would not go without the app.</string>
    <!-- Page 3 -->
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">feed the llamas</string>
    <string name="about_no_browser">No browser is installed.</string>
    <!-- Button that closes the first-run notice -->
    <string name="safety_ok">Understood</string>

    <!-- Licences page, reached from About -->
    <string name="licences_title">Licences</string>
    <string name="licences_source_heading">Source code</string>
    <string name="licences_source">Source: %1$s</string>
    <string name="licences_licence_heading">Licence</string>
    <string name="licences_licence">Detour is free software under the GNU General Public License, version 3 only. Copyright wander wildwood. The full text is below.</string>
    <string name="licences_built_heading">Built with</string>
    <string name="licences_gpl">GNU General Public License, version 3</string>
    <string name="licences_apache">Apache License, version 2.0</string>
    <string name="licences_ofl">SIL Open Font License, version 1.1</string>
    <string name="licences_no_browser">No browser is installed.</string>
    <!-- The folio at the foot of a paged list, "2 / 6"; a tap on it asks for a page -->
    <string name="folio_of">%1$d / %2$d</string>
    <string name="folio_go_title">Go to page</string>
    <string name="folio_page">Page %1$d of %2$d</string>
    <string name="folio_go">Go</string>
    <string name="folio_cancel">Cancel</string>
</resources>
