<?xml version="1.0" encoding="utf-8"?>
<!-- A double blaze: the waymark painted on a tree or a rock where a trail turns.
     Two bars, the upper one offset to the side the path goes.

     Painted rather than ruled. The edges wobble because a blaze is put on with a brush
     by whoever maintains that stretch, and this is a mark rather than an interface -
     the one place in this app where an irregular line belongs.

     The launcher masks this to a shape it chooses and only the central 66 of these 108
     units are certain to survive. Everything here sits inside that circle, which for an
     off-centre pair of bars is the constraint that actually bites: measured from the
     bounding box it would fit, and the corners would still be cut. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the lower blaze -->
    <path
        android:fillColor="#000000"
        android:pathData="M41.6,54.4 C44,53.9 48.6,54.2 51,54 C51.4,60.4 50.6,70.2 51.2,79.4 C48.4,80.3 44.2,79.5 41.2,80 C40.8,71.2 41.9,62 41.6,54.4 Z" />

    <!-- the upper blaze, offset: the turn -->
    <path
        android:fillColor="#000000"
        android:pathData="M57.4,26.6 C60.1,25.9 64.4,26.5 67,26.2 C67.5,33.4 66.6,44.1 67.2,51.6 C64.2,52.5 60.2,51.7 57.2,52.2 C56.8,44.2 57.9,34.1 57.4,26.6 Z" />
</vector>
