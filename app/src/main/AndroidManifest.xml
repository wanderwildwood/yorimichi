<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Where you are, to scatter the points around. Coarse is not enough: the walk
         can be a few hundred metres, and a fix good to a city block would put the
         start somewhere you are not. Nothing is stored and nothing is sent: there is
         no INTERNET permission here, and the numbers come from the device. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- What this app means to look for on the phone. Without it, asking whether
         anything can open a map quietly answers no from Android 11 onwards, however
         many map apps are installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
