<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Where you are, to scatter the points around. Coarse is not enough: the walk
         can be a few hundred metres, and a fix good to a city block would put the
         start somewhere you are not. Only the last fix is kept, on the phone, and
         nothing is sent: there is no INTERNET permission here, and the numbers come
         from the device. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12 offers the choice between precise and approximate and expects both to be asked
         for together; Detour still needs the precise one and says so if only this is given. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- What this app means to look for on the phone. Without it, asking whether
         anything can open a map quietly answers no from Android 11 onwards, however
         many map apps are installed. -->
    <queries>
        <!-- Browsers: a web address opens in a real one, never in the system's bare WebView shell. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
